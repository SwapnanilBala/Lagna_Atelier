<?xml version="1.0" encoding="utf-8"?>
<!--
   Nothing leaves the phone, by cloud backup or by phone-to-phone transfer
   (Android 12 and later).

   On these versions allowBackup="false" stops cloud backup but not device
   transfer, so both are excluded here explicitly. Saved charts and palm
   readings are promised to stay on this phone, and so is the signed-in
   session (lagna_session), whose Keystore key is never backed up.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
