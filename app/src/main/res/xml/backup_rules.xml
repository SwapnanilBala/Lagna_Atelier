<?xml version="1.0" encoding="utf-8"?>
<!--
   Nothing leaves the phone in a backup (Android 11 and earlier).

   Saved charts (names, birth details) and palm readings with their photos are
   promised to stay on this phone, so every domain is excluded. allowBackup is
   also false in the manifest; this file is the belt to that brace. The
   signed-in session (lagna_session) is excluded too: its Keystore key is
   never backed up, so a restored copy could not be read anyway.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
